+// precompressedResponseWriter applies sidecar headers only when ServeContent
+// commits a content response. In particular, it preserves ServeContent's removal
+// of representation headers for a 304 and does not add them to a 412.
+type precompressedResponseWriter struct {
+	http.ResponseWriter
+	encoding string
+	size     int64
+}
+
+func (wr precompressedResponseWriter) WriteHeader(code int) {
+	if code == http.StatusOK || code == http.StatusPartialContent {
+		h := wr.Header()
+		h.Set("Content-Encoding", wr.encoding)
+		// Preserve ServeContent's single-range or multipart length. A 200
+		// response serves the full sidecar, even when Range was ignored.
+		if code == http.StatusOK {
+			h.Set("Content-Length", strconv.FormatInt(wr.size, 10))
+		}
+	}
+	wr.ResponseWriter.WriteHeader(code)
+}
+
+// Unwrap returns the underlying ResponseWriter for http.ResponseController.
+func (wr precompressedResponseWriter) Unwrap() http.ResponseWriter {
+	return wr.ResponseWriter
+}
+
